{
  "_version": "1.73.1",
  "sap.app": {
    "id": "zrap100ih",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.19.3",
      "toolsId": "e2f3e2e6-399e-45d3-9f15-73b820b99878"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_flight_ih_o4/srvd/sap/zui_flight_ih_o4/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "zrap_100-display": {
          "semanticObject": "zrap_100",
          "action": "display",
          "title": "{{zrap_100-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.8",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zrap100ih.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "FlightIHList",
          "target": "FlightIHList"
        },
        {
          "pattern": "FlightIH({key}):?query:",
          "name": "FlightIHObjectPage",
          "target": "FlightIHObjectPage"
        },
        {
          "pattern": "FlightIH({key})/_DetailsIH({key2}):?query:",
          "name": "FlightDetailsObjectPage",
          "target": "FlightDetailsObjectPage"
        }
      ],
      "targets": {
        "FlightIHList": {
          "type": "Component",
          "id": "FlightIHList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/FlightIH",
              "variantManagement": "Page",
              "navigation": {
                "FlightIH": {
                  "detail": {
                    "route": "FlightIHObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              },
              "content": {
                "header": {
                  "actions": {
                    "ongotoWeb": {
                      "press": "zrap100ih.ext.controller.GoToWebHandler.GotoWeb",
                      "visible": true,
                      "enabled": true,
                      "text": "Go to Web"
                    }
                  }
                }
              }
            }
          }
        },
        "FlightIHObjectPage": {
          "type": "Component",
          "id": "FlightIHObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/FlightIH",
              "navigation": {
                "_DetailsIH": {
                  "detail": {
                    "route": "FlightDetailsObjectPage"
                  }
                }
              },
              "content": {
                "body": {
                  "sections": {
                    "GeoMap": {
                      "template": "zrap100ih.ext.fragment.GeoMap",
                      "position": {
                        "placement": "After",
                        "anchor": "GeneralInfo"
                      },
                      "title": "Itinerary"
                    }
                  }
                },
                "header": {
                  "actions": {
                    "goToWeb": {
                      "press": "zrap100ih.ext.controller.ObjectPageExt.onButtonPress",
                      "visible": true,
                      "enabled": true,
                      "text": "Go to Web",
                      "position": {
                        "placement": "Before",
                        "anchor": "EditAction"
                      }
                    },
                    "test": {
                      "press": "zrap100ih.ext.controller.Ext.testpress",
                      "visible": true,
                      "enabled": true,
                      "text": "test",
                      "position": {
                        "placement": "After",
                        "anchor": "EditAction"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "FlightDetailsObjectPage": {
          "type": "Component",
          "id": "FlightDetailsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/FlightIH/_DetailsIH"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
